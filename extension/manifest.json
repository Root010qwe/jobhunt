{
  "manifest_version": 3,
  "name": "JobHunt — отклик в один клик",
  "version": "1.1.0",
  "description": "Заполняет формы откликов данными из JobHunt (localhost:8765): ФИО, контакты, сопроводительное письмо, файл резюме.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:8765/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "JobHunt" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "exclude_matches": ["http://localhost:8765/*", "http://127.0.0.1:8765/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "icons": { "128": "icon.png" }
}
